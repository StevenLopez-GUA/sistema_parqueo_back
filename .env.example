# Copiar este archivo como backend/.env (el backend lo lee al arrancar).
# Modo de conexion con la maqueta: simulador | serial | http
#   http = maqueta real del grupo (Arduino R4 WiFi)
MODO_HARDWARE=simulador

# Solo se usan cuando MODO_HARDWARE=serial
# Windows:  COM3        Linux: /dev/ttyACM0        Mac: /dev/cu.usbmodem14201
PUERTO_SERIAL=COM3
BAUDIOS=115200

PUERTO=8080

# MODO_HARDWARE=http  -> maqueta real del grupo (Arduino R4 WiFi).
# El Arduino postea a http://<ip-de-la-laptop>:8080/api/v1/sensores
# ESPACIOS=5 solo aplica al simulador.
