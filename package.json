{
  "name": "parqueo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema Inteligente de Parqueo - backend, interprete y puente con la maqueta",
  "scripts": {
    "dev": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" tsx watch src/servidor.ts",
    "start": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" tsx src/servidor.ts",
    "build": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" tsc",
    "bd:reset": "node -e \"require('fs').rmSync('parqueo.db',{force:true});require('fs').rmSync('parqueo.db-wal',{force:true});require('fs').rmSync('parqueo.db-shm',{force:true});console.log('base de datos borrada')\""
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
